{
  "$schema": "https://raw.githubusercontent.com/nicedoc/schemas/main/tauri-conf.schema.json",
  "productName": "Luma",
  "version": "1.3.0",
  "identifier": "com.luma.chat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Luma",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#0e0e10",
        "devtools": true
      }
    ],
    "security": {
      "csp": "img-src 'self' data: blob:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/deXterbed/luma-chat/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzN0U3NDAzODJFMEZCQkUKUldTKysrQ0NBM1IrMDQ0dW1iTjBRTDlHUU82QUN6WGtEdEtzblBEYXBrdlFYZ295Mm12c0hUS0gK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
