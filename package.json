{
  "name": "luma",
  "version": "1.0.0",
  "description": "Dual-pane AI chat desktop app powered by Ollama",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "ollama": "^0.5.9",
    "zustand": "^4.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "lucide-react": "^0.383.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.3.1",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^3.4.4",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38"
  },
  "build": {
    "appId": "com.luma.chat",
    "productName": "Luma",
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "directories": {
      "output": "dist-electron"
    }
  }
}
